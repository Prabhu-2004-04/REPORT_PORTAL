# Supabase public/anon URL and key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_publishable_key

# Optional: override default assignments bucket name (default: assignments)
VITE_ASSIGNMENTS_BUCKET=assignments

# Optional: OpenAI key for real AI evaluations
VITE_OPENAI_API_KEY=your_openai_api_key
